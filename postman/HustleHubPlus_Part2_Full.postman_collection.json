            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200: 01 Health check', function () { pm.response.to.have.status(200); });",
              "pm.test('Health value OK',()=>pm.expect(pm.response.json().status).to.equal('ok'));"
