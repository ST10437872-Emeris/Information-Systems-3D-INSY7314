{
  "info": {
    "name": "HustleHubPlus - Member 1 Part 1",
    "description": "Requests for demonstrating the backend/API foundation, registration, login, validation and protected JWT route.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:5000" },
    { "key": "jwt", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo@hustlehubplus.test\",\n  \"password\": \"SecurePass1!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@hustlehubplus.test\",\n  \"password\": \"SecurePass1!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Current User - Protected",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "Invalid Registration - Validation Demo",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"<script>alert(1)</script>\",\n  \"email\": \"bad-email\",\n  \"password\": \"123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    }
  ]
}
